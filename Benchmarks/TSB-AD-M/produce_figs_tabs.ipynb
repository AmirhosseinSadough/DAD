    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "df_VUS_PR = pd.read_csv('TSB-AD/benchmark_exp/benchmark_eval_results/multi_mergedTable_VUS-PR_updated.csv')\n",
    "\n",
    "Comparaed_Solution_Pool = [\n",
