    "            _, p_less    = wilcoxon(diff, alternative='less')\n",
    "\n",
    "            if p_greater <= alpha_strong:\n",
    "                symbols.loc[m_a, m_b] = '$++$'\n",
    "            elif p_greater <= alpha_weak:\n",
    "                symbols.loc[m_a, m_b] = '$+$'\n",
    "            elif p_less <= alpha_strong:\n",
    "                symbols.loc[m_a, m_b] = '$--$'\n",
    "            elif p_less <= alpha_weak:\n",
    "                symbols.loc[m_a, m_b] = '$-$'\n",
